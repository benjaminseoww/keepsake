{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "client-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
